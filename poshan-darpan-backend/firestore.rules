rules_version = '2';

// All reads/writes to Firestore are routed through the backend Express API,
// which uses the Firebase Admin SDK and bypasses these rules. So for direct
// client access (Web SDK with end-user token) we deny everything.
//
// If a future build introduces direct-client reads (e.g. realtime dashboards),
// replace the catch-all `allow read, write: if false;` with role-scoped rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
